# Copy this file to .env and fill in real values before running docker compose.

# --- Postgres ---
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ledgerly
DATABASE_URL=postgresql+psycopg://ledgerly:change-me-locally@postgres:5432/ledgerly

# --- Redis (Celery broker/result backend) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage / "AIStor local") ---
MINIO_ROOT_USER=ledgerly
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=ledgerly-documents
MINIO_SECURE=false

# --- Keycloak (auth/OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=ledgerly
KEYCLOAK_BACKEND_CLIENT_ID=ledgerly-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=ledgerly-backend-dev-secret
KEYCLOAK_FRONTEND_CLIENT_ID=ledgerly-frontend

# --- CORS ---
# Comma-separated. Defaults (set in code) cover local dev; add your real
# origin(s) here for any non-local deployment.
# CORS_ALLOW_ORIGINS=https://ledgerly.example.com

# --- Secrets management ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- AI provider (extraction + exception explanation) ---
# If unset, invoices are held in needs_review rather than failing.
ANTHROPIC_API_KEY=

# --- Mail (dev only, caught by Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@ledgerly.local

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=ledgerly
VITE_KEYCLOAK_CLIENT_ID=ledgerly-frontend
